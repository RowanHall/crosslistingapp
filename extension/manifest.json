{
    "manifest_version": 3,
    "name": "Crosslisting App",
    "version": "1.0",
    "description": "Crosslist items between platforms",
    "permissions": [
        "sidePanel",
        "activeTab",
        "scripting",
        "storage",
        "cookies",
        "webRequest",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "https://*.depop.com/*",
        "https://*.poshmark.com/*",
        "http://localhost:3000/*",
        "https://webapi.depop.com/*",
        "https://*.grailed.com/*",
        "https://*.algolia.net/*",
        "https://*.algolianet.com/*",
        "https://*.facebook.com/*",
        "https://*.ebay.com/*",
        "https://*.ebay.ca/*",
        "https://*.ebay.co.uk/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.depop.com/*"
            ],
            "js": [
                "scripts/bridge.js"
            ]
        },
        {
            "matches": [
                "https://poshmark.com/create-listing"
            ],
            "js": [
                "scripts/poshmark-filler.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://www.depop.com/products/create/*"
            ],
            "js": [
                "scripts/depop-filler.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "http://localhost:3000/*"
            ],
            "js": [
                "scripts/content.js"
            ]
        },
        {
            "matches": ["https://www.facebook.com/*"],
            "js": ["scripts/facebook-scraper.js"],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://www.ebay.com/sl/prelist/suggest*",
                "https://www.ebay.ca/sl/prelist/suggest*",
                "https://www.ebay.co.uk/sl/prelist/suggest*",
                "https://www.ebay.com/sl/prelist/identify*",
                "https://www.ebay.ca/sl/prelist/identify*",
                "https://www.ebay.co.uk/sl/prelist/identify*",
                "https://www.ebay.com/lstng*",
                "https://www.ebay.ca/lstng*",
                "https://www.ebay.co.uk/lstng*"
            ],
            "js": ["scripts/ebay-filler.js"],
            "run_at": "document_end"
        }
    ],
    "side_panel": {
        "default_path": "sidepanel.html"
    }
}